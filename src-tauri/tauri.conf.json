{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klipt",
  "version": "0.2.0",
  "identifier": "com.klipt.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Klipt",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
